<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Stribe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Stribe.Views"
    xmlns:onboarding="clr-namespace:Stribe.Views.Onboarding"
    Shell.FlyoutBehavior="Disabled"
    Title="Stribe">

    <!-- Splash Screen -->
    <ShellContent
        Route="splash"
        ContentTemplate="{DataTemplate views:SplashPage}" />

    <!-- Onboarding Welcome -->
    <ShellContent
        Route="onboarding"
        ContentTemplate="{DataTemplate onboarding:WelcomePage}" />

    <!-- Main App - Home -->
    <ShellContent
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>
